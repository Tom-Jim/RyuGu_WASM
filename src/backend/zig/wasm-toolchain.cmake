set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
find_program(RYUGU_ZIG zig REQUIRED)
set(CMAKE_C_COMPILER "${RYUGU_ZIG}" cc)
set(CMAKE_CXX_COMPILER "${RYUGU_ZIG}" c++)
set(CMAKE_C_FLAGS_INIT "-target wasm32-wasi")
set(CMAKE_CXX_FLAGS_INIT "-target wasm32-wasi -fno-exceptions")
set(CMAKE_C_ARCHIVE_CREATE "${RYUGU_ZIG} ar qc <TARGET> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "${RYUGU_ZIG} ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_CREATE "${RYUGU_ZIG} ar qc <TARGET> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_FINISH "${RYUGU_ZIG} ranlib <TARGET>")
