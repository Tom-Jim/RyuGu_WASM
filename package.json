{
  "name": "ryugu-wasm",
  "version": "0.1.0",
  "private": true,
  "main": "src/tools/run.mjs",
  "module": "src/tools/run.mjs",
  "scripts": {
    "start": "node src/tools/run.mjs",
    "preview": "node src/tools/run.mjs",
    "dev": "node src/tools/run.mjs --dev",
    "serve": "bun src/server.ts",
    "fetch:cpp": "node src/tools/fetch_cpp.mjs",
    "build:cpp": "node src/tools/build_cpp_wasm.mjs",
    "build:backend": "bun run build:cpp && node src/tools/build_rust_backend.mjs",
    "check:wasm": "node src/tools/check_wasm_build.mjs",
    "build:wasm": "node src/tools/build_wasm.mjs --dev",
    "build": "node src/tools/build_wasm.mjs --release",
    "styles": "bunx @tailwindcss/cli -i src/html/tailwind.css -o src/html/tailwind.generated.css --minify"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
